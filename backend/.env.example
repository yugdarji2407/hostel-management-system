NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?schema=public
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=ksv_session
PASSWORD_RESET_COOKIE_NAME=ksv_password_reset
LOGIN_CHALLENGE_COOKIE_NAME=ksv_login_challenge
SESSION_SECRET=replace-with-at-least-32-random-characters
QR_TOKEN_SECRET=replace-with-at-least-32-random-characters
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
REDIS_URL=redis://REDIS_HOST:6379
HOSTEL_TIMEZONE=Asia/Kolkata
ATTACHMENTS_DIR=./var/attachments
MAX_ATTACHMENT_SIZE_MB=5

# OTP delivery
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=KSV Hostel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
OTP_DEFAULT_COUNTRY_CODE=+91
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_WINDOW_SECONDS=3600
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_VERIFY_RATE_WINDOW_SECONDS=900
OTP_MAX_VERIFY_REQUESTS_PER_WINDOW=10
OTP_RETENTION_SECONDS=86400
# For Vercel frontend + Render backend, use COOKIE_SAME_SITE=none in production.

# Secure server-side admin bootstrap (set these in the real deployment environment)
ADMIN_EMAIL=
ADMIN_PASSWORD=
