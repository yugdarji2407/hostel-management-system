PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-in-production

# Postgres connection string from your Supabase project: Project Settings ->
# Database -> Connection string -> "URI" (use the "Transaction pooler" one,
# port 6543, for serverless/most hosts — use the direct :5432 one only if
# your host supports long-lived connections). Example shape:
# postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Google Sign-In — create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials and add your frontend
# origin(s) under "Authorized JavaScript origins". This value is NOT secret
# (it's also used on the frontend as VITE_GOOGLE_CLIENT_ID) — Google Sign-In
# has no separate client secret for this flow.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Email OTP via Brevo
BREVO_API_KEY=xkeysib-your-key
BREVO_SENDER_EMAIL=verified-sender@example.com

# Phone SMS OTP via Twilio
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# OTP security
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_MS=60000
OTP_VERIFICATION_TTL_MS=600000

# Production frontend URL for CORS, if supported by your deployment/router
FRONTEND_URL=https://your-frontend.vercel.app
APP_URL=https://your-frontend.vercel.app
