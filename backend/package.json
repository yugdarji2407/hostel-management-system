{
  "name": "ksv-hostel-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.45.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.5.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "vitest": "^3.0.9"
  }
}
